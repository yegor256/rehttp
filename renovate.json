{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "automerge": true,
  "extends": [
    "config:base"
  ],
  "platformAutomerge": false,
  "packageRules": [
    {
      "description": "Avoid replacing xml-apis with an older version of itself",
      "matchPackageNames": ["xml-apis:xml-apis"],
      "matchUpdateTypes": ["replacement"],
      "enabled": false
    }
  ]
}
