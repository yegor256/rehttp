{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "automerge": true,
  "extends": [
    "config:base"
  ],
  "packageRules": [
    {
      "description": "Avoid replacing xml-apis with an older version of itself",
      "enabled": false,
      "matchPackageNames": [
        "xml-apis:xml-apis"
      ],
      "matchUpdateTypes": [
        "replacement"
      ]
    }
  ],
  "platformAutomerge": false
}
